{
  // decrypt.aauth.dev — the decrypt Worker. Multi-tenant: keys in D1,
  // wrapped with the KEK secret. Self-host: deploy the same Worker at your
  // own origin with your own D1 and KEK (README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decrypt-aauth-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  "routes": [{ "pattern": "decrypt.aauth.dev", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS" },

  "vars": {
    "SERVICE": "decrypt",
    "ORIGIN": "https://decrypt.aauth.dev",
    // The messaging service readMessage downloads from and rotateKey reports
    // to when the caller gives no `resource` (D27, Q7). The only place it is named.
    "DEFAULT_RESOURCE": "https://secret.agent.coop"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "decrypt-aauth-dev", "database_id": "b22d7df8-13be-4d3b-9940-b37074123fdd", "migrations_dir": "migrations" }
  ],

  // Daily: purge retired keys past purge_after.
  "triggers": { "crons": ["23 3 * * *"] },

  // A second read service, to test secret's setServices live (plan
  // read-send-services Q13, 13c step 5): the same code at
  // decrypt-test.aauth.dev with its own D1, KEK, SIGNING_KEY and AGENT_KEY.
  // `wrangler deploy --env test`. vars, routes and d1_databases are not
  // inherited by an environment, so they are all here. Create the database
  // with `wrangler d1 create decrypt-test-aauth-dev` and put its id below;
  // the placeholder makes a deploy fail rather than use the wrong database.
  "env": {
    "test": {
      "name": "decrypt-test-aauth-dev",
      "routes": [{ "pattern": "decrypt-test.aauth.dev", "custom_domain": true }],
      "vars": {
        "SERVICE": "decrypt-test",
        "ORIGIN": "https://decrypt-test.aauth.dev",
        "DEFAULT_RESOURCE": "https://secret.agent.coop"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "decrypt-test-aauth-dev", "database_id": "REPLACE_WITH_DECRYPT_TEST_D1_ID", "migrations_dir": "migrations" }
      ],
      "triggers": { "crons": ["23 3 * * *"] }
    }
  }

  // Secrets (wrangler secret put):
  //   KEK         — 32 random bytes, base64url (npm run generate-kek); wraps private keys
  //   SIGNING_KEY — Ed25519 private JWK (npm run generate-key); signs this
  //                 service's agent token, published at /.well-known/jwks.json
  //   AGENT_KEY   — Ed25519 private JWK (npm run generate-key); signs the
  //                 requests readMessage and rotateKey make as an intermediary; cnf.jwk in
  //                 the agent token and in the chained person token
}
